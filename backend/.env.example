# ===============================================================
# DEMS (Digital Evidence Mission) — Environment Configuration Template
# Copy this file to .env and configure appropriate values before deployment
# ===============================================================

# ── 1. Server Configuration ──
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── 2. Database Configuration ──
# Primary database connection (MongoDB 6+ recommended)
MONGODB_URI=mongodb://localhost:27017/dems

# ── 3. JWT & Authentication Security ──
# Generate high-entropy 256-bit keys for production: openssl rand -hex 32
JWT_SECRET=dems-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dems-super-secret-refresh-key-change-in-production-2026

# ── 4. Cryptographic Encryption Service ──
# 32-byte hex key for AES-256-GCM evidence encryption: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 5. Google Gemini AI Intelligence Service ──
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── 6. Cybersecurity & Rate Limiting ──
# Window size in milliseconds (15 mins = 900000)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
BCRYPT_SALT_ROUNDS=12

# ── 7. Evidence File Storage & Limits ──
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
